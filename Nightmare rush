-- Server script: đặt trong ServerScriptService hoặc Workspace (dùng executor có isfile/writefile/getcustomasset)
local RunService = game:GetService("RunService")
if not RunService:IsServer() then
    warn("Chạy trên client? Script này nên chạy server-side.")
end

local spawner = loadstring(game:HttpGet("https://raw.githubusercontent.com/RegularVynixu/Utilities/main/Doors/Entity%20Spawner/V2/Source.lua"))()

-- ---------- helper để tạo / lấy main color correction nếu chưa có ----------
local Lighting = game:GetService("Lighting")
local function ensureMainColorCorrection()
    local cc = Lighting:FindFirstChild("MainColorCorrection")
    if not cc then
        cc = Instance.new("ColorCorrectionEffect")
        cc.Name = "MainColorCorrection"
        cc.Parent = Lighting
    end
    return cc
end

local cc = ensureMainColorCorrection()

--
-- ---------- lighting effects (an toàn nếu thiếu cc) ----------
cc.TintColor = Color3.fromRGB(255,255,255)
cc.Contrast = 1

local TweenService = game:GetService("TweenService")
pcall(function()
    TweenService:Create(cc, TweenInfo.new(2.5), {Contrast = 0}):Play()
    TweenService:Create(cc, TweenInfo.new(80), {TintColor = Color3.fromRGB(255,255,255)}):Play()
end)

-- ---------- random seed ----------
math.randomseed(tick() + os.time())

-- ---------- random parameters (đảm bảo "spawn ngẫu nhiên" theo preference bạn lưu) ----------
local randSpeed = math.random(50, 90)          -- speed ngẫu nhiên 50..90
local randDelay = math.random(1, 3)           -- delay ngẫu nhiên 1..3
local randHeight = (math.random(-2, 2))       -- height offset -2..2
local randReboundOn = (math.random(0,1) == 1) -- bật/tắt rebound ngẫu nhiên
local randReboundMin = math.random(2,4)
local randReboundMax = randReboundMin + math.random(1,3)

-- ---------- tạo entity với các tham số ngẫu nhiên ----------
local entity = spawner.Create({
 Entity = {
  Name = "nightmare rush",
  Asset = "rbxassetid://90736658296439", -- thay nếu cần
  HeightOffset = randHeight
 },
 Lights = {
  Flicker = { Enabled =true, Duration = 5 },
  Shatter =false,
  Repair = false
 },
 CameraShake = {
  Enabled = true,
  Range = 100,
  Values = {2, 25, 0.1, 1}
 },
 Movement = {
  Speed = 267,
  Delay = randDelay,
  Reversed = false
 },
 Rebounding = {
  Enabled = false,
  Type = "Ambush",
  Min = randReboundMin,
  Max = randReboundMax,
  Delay = 2
 },
 Damage = {
  Enabled = true,
  Range = 50,
  Amount = 9999
 },
 Crucifixion = {
  Enabled =true,
  Range = 40,
  Resist = true,
  Break = true
 },
 Death = {
  Type = "Guiding",
  Hints = {"nightmare rush he like rush but red"},
  Cause = "nightmare rush"
 }
})

-- ---------- OnDamagePlayer callback: nhận player (server) và set GameStats an toàn ----------
entity:SetCallback("OnDamagePlayer", function(player, newHealth)
    -- player có thể là Player instance — kiểm tra an toàn
    if typeof(player) ~= "Instance" or not player:IsA("Player") then return end

    pcall(function()
        local ReSt = game:GetService("ReplicatedStorage")
        if ReSt and ReSt:FindFirstChild("GameStats") then
            local stats = ReSt.GameStats:FindFirstChild("Player_"..player.Name)
            if stats and stats:FindFirstChild("Total") and stats.Total:FindFirstChild("DeathCause") then
                stats.Total.DeathCause.Value = "nightmare rush"
            end
        end
    end)
end)

-- ---------- chạy entity ----------
entity:Run()
